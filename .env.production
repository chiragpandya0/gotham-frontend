# Loaded automatically by `vite build` (production mode). Committed —
# contains no secrets. See README.md "Environment variables".
#
# Empty on purpose: in prod the app is served from the same origin nginx
# proxies /api from (see deploy/nginx-gotham.conf), so requests should be
# relative (/api/me), not point at localhost. Leaving this unset would fall
# back to the code default (http://localhost:8000) — the browser's own
# machine, not the server. Do not put a real value here.
VITE_API_BASE_URL=

# Real value goes in .env.production.local on the server (gitignored, same
# pattern as .env.local in local dev) — never commit the key itself.
VITE_CARTO_API_KEY=
